# Copy to .env and fill in real values. Never commit .env itself.

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/growverde?retryWrites=true&w=majority

# Auth — generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7
JWT_EXPIRES_IN_DAYS_REMEMBER=30

# Server
PORT=4000
NODE_ENV=development
# Exact deployed frontend URL in production (no trailing slash) —
# CORS and the session cookie's cross-site behavior depend on this
# being correct.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_LOGIN_URL=http://localhost:5173/login

# Email — sent via Hostinger's HTTP Mail API, not raw SMTP (Render and
# some other hosts block outbound SMTP ports at the network level).
# Leave HOSTINGER_API_TOKEN blank to log emails to the console instead
# of sending them — useful for local development/grading without real
# credentials. Create a token in the Hostinger Panel's email
# provisioning tab.
HOSTINGER_API_TOKEN=
HOSTINGER_MAILBOX_ADDRESS=
EMAIL_DISPLAY_NAME="Growverde Solutions"

# Where internal submissions (Information Setup, Support, etc.) are emailed to.
COMPANY_NOTIFY_EMAIL=
